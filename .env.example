# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB connection string (e.g., MongoDB Atlas or local MongoDB instance)
# If not provided, FarmConnect falls back seamlessly to an in-memory/JSON store for instant hackathon evaluation.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/farmconnect?retryWrites=true&w=majority"

# JWT Secret for signing session tokens
JWT_SECRET="your-super-secret-jwt-key-farmconnect-hackathon"

# Server Port
PORT=3000

# Client Application URL
CLIENT_URL="http://localhost:3000"

# Frontend API base URL (defaults to /api)
VITE_API_BASE_URL="/api"
